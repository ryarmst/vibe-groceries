# Copy to .env and fill in. Never commit .env.

# --- Required ------------------------------------------------------------------------------
# The domain pointing at this VPS (an A/AAAA record). Caddy gets a Let's Encrypt certificate for it.
DOMAIN=groceries.example.com
ACME_EMAIL=you@example.com
PUBLIC_URL=https://groceries.example.com

# Encrypts the secrets vault (LLM keys, Notion token, No Frills session). 32 random bytes, base64:
#   openssl rand -base64 32      (or: docker compose run --rm app vibe master-key)
# Keep a copy somewhere safe: without it the stored keys can't be decrypted (just re-enter them).
MASTER_KEY=

# The public x-apikey the No Frills website sends to api.pcexpress.ca (same for every visitor).
# DevTools → Network → any request to api.pcexpress.ca → Request headers → x-apikey.
PCX_API_KEY=

# --- Client certificates (mTLS) ----------------------------------------------------------------
# on: Caddy refuses any connection without a client certificate issued by `vibe pair --cert`, and the
# app checks the certificate belongs to the signed-in browser. Run `vibe ca` once before switching on.
MTLS_MODE=off
MTLS_REQUIRED=false

# --- Optional ------------------------------------------------------------------------------------
STORE_ID=3728
TZ=America/Toronto
# Default monthly LLM spend cap (USD); change it any time in the extension (Settings → LLM budget).
MONTHLY_BUDGET_USD=10
# Deal scan every N hours (0 = off). About 200 requests to No Frills, ~3 minutes.
DEAL_SCAN_HOURS=24
