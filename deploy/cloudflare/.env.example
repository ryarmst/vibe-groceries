# Copy to .env and fill in. Never commit .env.

PUBLIC_URL=https://groceries.ryarmst.ca

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install command (the long token).
TUNNEL_TOKEN=

# Encrypts the secrets vault. 32 random bytes, base64: openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored keys can't be decrypted (you'd re-enter them).
MASTER_KEY=

# The public x-apikey the No Frills website sends to api.pcexpress.ca (same for every visitor).
PCX_API_KEY=

# Require Cloudflare-verified client certificates, bound to each paired browser.
# Keep false until the certificates are set up and imported (see README), then set true.
MTLS_REQUIRED=false

STORE_ID=3728
TZ=America/Toronto
MONTHLY_BUDGET_USD=10
DEAL_SCAN_HOURS=24
